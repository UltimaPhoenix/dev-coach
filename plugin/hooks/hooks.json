{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:devcoach:devcoach",
            "tool": "hook_stop",
            "input": {
              "session_id": "${session_id}",
              "stop_hook_active": "${stop_hook_active}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:devcoach:devcoach",
            "tool": "hook_prompt",
            "input": {
              "session_id": "${session_id}",
              "stop_hook_active": "${stop_hook_active}",
              "permission_mode": "${permission_mode}"
            },
            "timeout": 30
          }
        ]
      }
    ]
  }
}
