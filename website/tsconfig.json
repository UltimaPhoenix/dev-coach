// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed `baseUrl`, which @docusaurus/tsconfig still sets: clear it and
    // re-declare `@site/*` here (without baseUrl, paths resolve from the file that declares them).
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    },
    // `npm test` (node --test) needs the `.ts` extension on relative imports; tsc never emits here.
    "allowImportingTsExtensions": true,
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
